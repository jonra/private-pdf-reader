{
  "manifest_version": 3,
  "name": "Private PDF Reader",
  "version": "1.0.0",
  "description": "Opens PDFs in a clean, private, local reader with thumbnails, search, signing, and themes. Nothing is uploaded.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Private PDF Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.css",
        "viewer.js",
        "lib/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
